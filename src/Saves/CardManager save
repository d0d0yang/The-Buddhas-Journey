import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.util.ArrayList;

public class CardManager {
    private Sketch sketch;
    private ArrayList<Cards> cardList;
    GameState gameState;

    public CardManager(Sketch sketch) {
        this.sketch = sketch;
        cardList = new ArrayList<>();
    }

    public void setGameState(GameState gameState) {
        this.gameState = gameState;
    }

    // Load the card data from a file and return as a string
    public String loadCardData(String fileName) {
        StringBuilder cardData = new StringBuilder();
        try {
            BufferedReader reader = new BufferedReader(new FileReader(fileName));
            String line;
            while ((line = reader.readLine()) != null) {
                cardData.append(line).append("\n");
            }
            reader.close();
        } catch (IOException e) {
            e.printStackTrace();
        }
        return cardData.toString();
    }

    // Parse the card data from a string and generate Card objects
    public void parseCardData(String cardData) {
        String[] cardEntries = cardData.split("\n\n");  // Separate cards by double newline
        for (String cardEntry : cardEntries) {
            String[] lines = cardEntry.split("\n");  // Split the card entry into lines

            String cardName = "";
            int cardIndex = 0;
            String lore = "";
            String cardType = "";
            int lifeForce = 0;
            int power = 0;
            String cardEffectLore = "";
            Runnable cardEffectEffect = () -> System.out.println("placeholder");
            int cardBorder = 0;
            String cardImagePath = "";

            // Loop through each line in the card entry and extract values
            for (String line : lines) {
                String[] keyValue = line.split(":");  // Split the line into key and value
                if (keyValue.length == 2) {
                    String key = keyValue[0].trim();
                    String value = keyValue[1].trim();

                    switch (key) {
                        case "cardName":
                            cardName = value;
                            break;
                        case "cardIndex":
                            cardIndex = Integer.parseInt(value);
                            break;
                        case "lore":
                            lore = value;
                            break;
                        case "cardType":
                            cardType = value;
                            break;
                        case "lifeForce":
                            lifeForce = Integer.parseInt(value);
                            break;
                        case "power":
                            power = Integer.parseInt(value);
                            break;
                        case "cardEffectLore":
                            cardEffectLore = value;
                            break;
                        case "cardBorder":
                            cardBorder = Integer.parseInt(value);
                            break;
                        case "cardImagePath":
                            cardImagePath = value;
                            break;
                    }
                }
            }

            // Create the card and add it to the list
            Cards card = new Cards(sketch, cardName, cardIndex, lore, runnableEffects(cardIndex)[0],
                    runnableEffects(cardIndex)[1], cardType, lifeForce, power, cardEffectLore,
                    cardBorder, cardImagePath);
            cardList.add(card);
        }
    }



